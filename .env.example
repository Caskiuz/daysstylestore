# ─────────── Base de datos (Neon Postgres) ───────────
# Crea tu base gratis en https://neon.tech y pega aquí la cadena de conexión (pooler)
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ─────────── Autenticación ───────────
# Genera un secreto con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ─────────── Admin inicial (solo se usa en el seed) ───────────
ADMIN_EMAIL="admin@daystylestore.com"
ADMIN_PASSWORD="DaysStyle2026"

# ─────────── WhatsApp de la tienda (número internacional sin +) ───────────
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"

# ─────────── URL del sitio (para SEO y compartir) ───────────
NEXT_PUBLIC_SITE_URL="https://daystylestore.vercel.app"

# ─────────── IA (Google AI Studio — Gemini Flash gratuito) ───────────
# Obtén tu API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ─────────── Cloudinary (fotos de productos) ───────────
# Crea tu cuenta gratis en https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
